{
  "dialect": "ainl.re.1",
  "note": "The docket expression is the worker's expression. Caption and counsel here are shapes with the same features, not the expressions in litigation_radar.py and competition_radar.py. Those stay in Python until the exact pattern is added to this file and the dialect test matches Python re.",
  "caps": {
    "pattern_chars": 256,
    "haystack_chars": 100000,
    "steps": 100000,
    "quantifier": 10000
  },
  "size_limit_is": "error_value",
  "patterns": {
    "docket": "\\b(?:\\d{1,2}:\\d{2}-(?:cv|cr|mc|md)-\\d{3,6}|No\\.\\s*\\d{2,4}-[A-Za-z0-9\\-]{2,12})\\b",
    "caption": "\\b(?:[A-Za-z][A-Za-z.'-]{0,40}(?:\\s+[A-Za-z][A-Za-z.'-]{0,40}){0,4})\\s+v\\.?\\s+(?:[A-Za-z][A-Za-z.'-]{0,40}(?:\\s+[A-Za-z][A-Za-z.'-]{0,40}){0,4})\\b",
    "counsel": "\\b(?:counsel(?:\\s+for\\s+the\\s+(?:plaintiff|defendant))?|attorney)\\b"
  },
  "samples": [
    "See 1:26-cv-00412 today",
    "1:26-CV-00412",
    "No. 24-AB12 end",
    "x1:26-cv-00412",
    "1:26-cv-12",
    "99:99-mc-123456",
    "Smith v. Jones",
    "SMITH V JONES",
    "Counsel for the Plaintiff",
    "the attorney appeared",
    "no counsel here",
    "pre-litigation counsel"
  ]
}
